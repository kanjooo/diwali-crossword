# Server-only: configure these in Vercel. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
TEACHER_EMAIL_ALLOWLIST=teacher1@example.edu,teacher2@example.edu

# Public Supabase client key, used only by /admin to call Supabase Auth.
# This is safe to expose, unlike the service-role key.
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
